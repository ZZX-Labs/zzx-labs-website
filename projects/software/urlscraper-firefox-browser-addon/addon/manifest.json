{
  "manifest_version": 2,
  "name": "URLScraper",
  "version": "0.3.0",
  "description": "Back up open Firefox tabs/URLs to TXT, CSV, JSON, or SQL.",
  "permissions": [
    "tabs",
    "downloads"
  ],
  "browser_action": {
    "default_title": "URLScraper",
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "urlscraper@zzx-labs.io",
      "strict_min_version": "109.0"
    }
  }
}
