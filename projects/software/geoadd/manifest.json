{
  "slug": "geoadd",
  "title": "GeoAdd",
  "blurb": "GeoAdd is a geo-addressing system providing reversible shortcodes with increasing precision, supporting OSM overlays and spatial APIs for Python-based geospatial workflows.",
  "href": "/projects/software/geoadd/",
  "github": "https://github.com/ZZX-Labs/geoadd",
  "logo": "/projects/software/geoadd/logo.png",
  "version": "0.1.0-alpha",
  "license": "MIT",
  "platforms": [
    "Linux",
    "Windows",
    "macOS"
  ],
  "tags": [
    "geospatial",
    "addressing",
    "osm",
    "mapping",
    "shortcodes",
    "api",
    "python",
    "cli",
    "zzx"
  ],
  "dependencies": [
    "python3",
    "geopy",
    "requests",
    "pandas",
    "matplotlib"
  ],
  "frameworks": [
    "Matplotlib"
  ],
  "web_version": "0.1.0-alpha-web",
  "web": {
    "capabilities": [
      "reversible geohash-style shortcode encoding",
      "decode to bounding box",
      "precision table",
      "batch CSV encode",
      "OSM area link"
    ],
    "format": "ga:<precision>:<base32-code>",
    "alphabet": "0123456789bcdefghjkmnpqrstuvwxyz"
  },
  "files": [
    "index.html",
    "style.css",
    "script.js",
    "geoadd.js",
    "hook.css",
    "hook.js",
    "manifest.json",
    "README.md"
  ]
}
