{"schema":"zzx-html-edition-profile-v1","country":"BV","name":"Bouvet Island","year":2005,"status":"source-extracted; field review pending","source":{"name":"factbook-2005.zip","member":"factbook-2005/geos/bv.html","sha256":"2213723e2477016328ab7ec0d43eb72abe65bb5f8db9ba768d9895aebf96a2cf","format":"html"},"rights_notice_member":"factbook-2005/docs/contributor_copyright.html","rights_notice_sha256":"cb1a3160f88028402c3ee933aabdf700e0161c6c130296b8cad004d84a2229db","fields":[{"category":"introduction","label":"Background","content":"This uninhabited volcanic island is almost entirely covered by glaciers and is difficult to approach. It was discovered in 1739 by a French naval officer after whom the island was named. No claim was made until 1825, when the British flag was raised. In 1928, the UK waived its claim in favor of Norway, which had occupied the island the previous year. In 1971, Bouvet Island and the adjacent territorial waters were designated a nature reserve. Since 1977, Norway has run an automated meteorological station on the island.","ordinal":1,"locator":"factbook-2005/geos/bv.html#field:1","country":"BV","edition_year":2005},{"category":"geography","label":"Location","content":"island in the South Atlantic Ocean, southwest of the Cape of Good Hope (South Africa)","ordinal":2,"locator":"factbook-2005/geos/bv.html#field:2","country":"BV","edition_year":2005},{"category":"geography","label":"Geographic coordinates","content":"54 26 S, 3 24 E","ordinal":3,"locator":"factbook-2005/geos/bv.html#field:3","country":"BV","edition_year":2005},{"category":"geography","label":"Map references","content":"Antarctic Region","ordinal":4,"locator":"factbook-2005/geos/bv.html#field:4","country":"BV","edition_year":2005},{"category":"geography","label":"Area","content":"total: 58.5 sq km\n\nland: 58.5 sq km\n\nwater: 0 sq km","ordinal":5,"locator":"factbook-2005/geos/bv.html#field:5","country":"BV","edition_year":2005},{"category":"geography","label":"Area - comparative","content":"about 0.3 times the size of Washington, DC","ordinal":6,"locator":"factbook-2005/geos/bv.html#field:6","country":"BV","edition_year":2005},{"category":"geography","label":"Land boundaries","content":"0 km","ordinal":7,"locator":"factbook-2005/geos/bv.html#field:7","country":"BV","edition_year":2005},{"category":"geography","label":"Coastline","content":"29.6 km","ordinal":8,"locator":"factbook-2005/geos/bv.html#field:8","country":"BV","edition_year":2005},{"category":"geography","label":"Maritime claims","content":"territorial sea: 4 nm","ordinal":9,"locator":"factbook-2005/geos/bv.html#field:9","country":"BV","edition_year":2005},{"category":"geography","label":"Climate","content":"antarctic","ordinal":10,"locator":"factbook-2005/geos/bv.html#field:10","country":"BV","edition_year":2005},{"category":"geography","label":"Terrain","content":"volcanic; coast is mostly inaccessible","ordinal":11,"locator":"factbook-2005/geos/bv.html#field:11","country":"BV","edition_year":2005},{"category":"geography","label":"Elevation extremes","content":"lowest point: South Atlantic Ocean 0 m\n\nhighest point: Olav Peak 935 m","ordinal":12,"locator":"factbook-2005/geos/bv.html#field:12","country":"BV","edition_year":2005},{"category":"geography","label":"Natural resources","content":"none","ordinal":13,"locator":"factbook-2005/geos/bv.html#field:13","country":"BV","edition_year":2005},{"category":"geography","label":"Land use","content":"arable land: 0%\n\npermanent crops: 0%\n\nother: 100% (93% ice) (2001)","ordinal":14,"locator":"factbook-2005/geos/bv.html#field:14","country":"BV","edition_year":2005},{"category":"geography","label":"Irrigated land","content":"0 sq km (1998 est.)","ordinal":15,"locator":"factbook-2005/geos/bv.html#field:15","country":"BV","edition_year":2005},{"category":"geography","label":"Natural hazards","content":"NA","ordinal":16,"locator":"factbook-2005/geos/bv.html#field:16","country":"BV","edition_year":2005},{"category":"geography","label":"Environment - current issues","content":"NA","ordinal":17,"locator":"factbook-2005/geos/bv.html#field:17","country":"BV","edition_year":2005},{"category":"geography","label":"Geography - note","content":"covered by glacial ice; declared a nature reserve","ordinal":18,"locator":"factbook-2005/geos/bv.html#field:18","country":"BV","edition_year":2005},{"category":"people-and-society","label":"Population","content":"uninhabited (July 2005 est.)","ordinal":19,"locator":"factbook-2005/geos/bv.html#field:19","country":"BV","edition_year":2005},{"category":"government","label":"Country name","content":"conventional long form: none\n\nconventional short form: Bouvet Island","ordinal":20,"locator":"factbook-2005/geos/bv.html#field:20","country":"BV","edition_year":2005},{"category":"government","label":"Dependency status","content":"territory of Norway; administered by the Polar Department of the Ministry of Justice and Police from Oslo","ordinal":21,"locator":"factbook-2005/geos/bv.html#field:21","country":"BV","edition_year":2005},{"category":"government","label":"Legal system","content":"the laws of Norway, where applicable, apply","ordinal":22,"locator":"factbook-2005/geos/bv.html#field:22","country":"BV","edition_year":2005},{"category":"government","label":"Flag description","content":"the flag of Norway is used","ordinal":23,"locator":"factbook-2005/geos/bv.html#field:23","country":"BV","edition_year":2005},{"category":"economy","label":"Economy - overview","content":"no economic activity; declared a nature reserve","ordinal":24,"locator":"factbook-2005/geos/bv.html#field:24","country":"BV","edition_year":2005},{"category":"communications","label":"Internet country code","content":".bv","ordinal":25,"locator":"factbook-2005/geos/bv.html#field:25","country":"BV","edition_year":2005},{"category":"communications","label":"Communications - note","content":"automatic meteorological station","ordinal":26,"locator":"factbook-2005/geos/bv.html#field:26","country":"BV","editio