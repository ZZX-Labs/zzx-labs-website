{"schema":"zzx-html-edition-profile-v1","country":"GG","name":"Guernsey","year":2006,"status":"source-extracted; field review pending","source":{"name":"factbook-2006.zip","member":"factbook-2006/geos/gk.html","sha256":"380e40561606e5fc71182bb1933ce796dd594a45eea9aea280ccaba6bcfea3fd","format":"html"},"rights_notice_member":"factbook-2006/docs/contributor_copyright.html","rights_notice_sha256":"35ef4ca41430051d8ecaf6d3d85b889b6c16c3e3f27f875ae279ea68a86a4edd","fields":[{"category":"introduction","label":"Background","content":"The island of Guernsey and the other Channel Islands represent the last remnants of the medieval Dukedom of Normandy, which held sway in both France and England. The islands were the only British soil occupied by German troops in World War II. Guernsey is a British crown dependency, but is not part of the UK.","ordinal":1,"locator":"factbook-2006/geos/gk.html#field:1","country":"GG","edition_year":2006},{"category":"geography","label":"Location","content":"Western Europe, islands in the English Channel, northwest of France","ordinal":2,"locator":"factbook-2006/geos/gk.html#field:2","country":"GG","edition_year":2006},{"category":"geography","label":"Geographic coordinates","content":"49 28 N, 2 35 W","ordinal":3,"locator":"factbook-2006/geos/gk.html#field:3","country":"GG","edition_year":2006},{"category":"geography","label":"Map references","content":"Europe","ordinal":4,"locator":"factbook-2006/geos/gk.html#field:4","country":"GG","edition_year":2006},{"category":"geography","label":"Area","content":"total: 78 sq km\n\nland: 78 sq km\n\nwater: 0 sq km\n\nnote: includes Alderney, Guernsey, Herm, Sark, and some other smaller islands","ordinal":5,"locator":"factbook-2006/geos/gk.html#field:5","country":"GG","edition_year":2006},{"category":"geography","label":"Area - comparative","content":"about one-half the size of Washington, DC","ordinal":6,"locator":"factbook-2006/geos/gk.html#field:6","country":"GG","edition_year":2006},{"category":"geogr