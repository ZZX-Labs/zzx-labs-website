{"schema":"zzx-html-edition-profile-v1","country":"CX","name":"Christmas Island","year":2007,"status":"source-extracted; field review pending","source":{"name":"factbook-2007.zip","member":"factbook-2007/geos/kt.html","sha256":"8e1c4cdcd89fe7d5eb2fe4251ab0154494bade3990c893bb67aaa4435f37863e","format":"html"},"rights_notice_member":"factbook-2007/docs/contributor_copyright.html","rights_notice_sha256":"0aa0c111c3015a738f223e5be4ed3275a829514a52d1781742a8671e915bdb1e","fields":[{"category":"introduction","label":"Background","content":"Named in 1643 for the day of its discovery, the island was annexed and settlement began by the UK in 1888. Phosphate mining began in the 1890s. The UK transferred sovereignty to Australia in 1958. Almost two-thirds of the island has been declared a national park.","ordinal":1,"locator":"factbook-2007/geos/kt.html#field:1","country":"CX","edition_year":2007},{"category":"geography","label":"Location","content":"Southeastern Asia, island in the Indian Ocean, south of Indonesia","ordinal":2,"locator":"factbook-2007/geos/kt.html#field:2","country":"CX","edition_year":2007},{"category":"geography","label":"Geographic coordinates","content":"10 30 S, 105 40 E","ordinal":3,"locator":"factbook-2007/geos/kt.html#field:3","country":"CX","edition_year":2007},{"category":"geography","label":"Map references","content":"Southeast Asia","ordinal":4,"locator":"factbook-2007/geos/kt.html#field:4","country":"CX","edition_year":2007},{"category":"geography","label":"Area","content":"total: 135 sq km\n\nland: 135 sq km\n\nwater: 0 sq km","ordinal":5,"locator":"factbook-2007/geos/kt.html#field:5","country":"CX","edition_year":2007},{"category":"geography","label":"Area - comparative","content":"about three-quarters the size of Washington, DC","ordinal":6,"locator":"factbook-2007/geos/kt.html#field:6","country":"CX","edition_year":2007},{"category":"geography","label":"Land boundaries","content":"0 km","ordinal":7,"locator":"factbook-2007/geos/kt.html#field