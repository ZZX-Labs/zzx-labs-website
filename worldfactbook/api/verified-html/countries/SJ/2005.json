{"schema":"zzx-html-edition-profile-v1","country":"SJ","name":"Svalbard","year":2005,"status":"source-extracted; field review pending","source":{"name":"factbook-2005.zip","member":"factbook-2005/geos/sv.html","sha256":"8c5ac19e1c8d92456cbf3a7a800e2f4ef2dd90389cd2edcabd422d0719a48c8d","format":"html"},"rights_notice_member":"factbook-2005/docs/contributor_copyright.html","rights_notice_sha256":"cb1a3160f88028402c3ee933aabdf700e0161c6c130296b8cad004d84a2229db","fields":[{"category":"introduction","label":"Background","content":"First discovered by the Norwegians in the 12th century, the islands served as an international whaling base during the 17th and 18th centuries. Norway's sovereignty was recognized in 1920; five years later it officially took over the territory.","ordinal":1,"locator":"factbook-2005/geos/sv.html#field:1","country":"SJ","edition_year":2005},{"category":"geography","label":"Location","content":"Northern Europe, islands between the Arctic Ocean, Barents Sea, Greenland Sea, and Norwegian Sea, north of Norway","ordinal":2,"locator":"factbook-2005/geos/sv.html#field:2","country":"SJ","edition_year":2005},{"category":"geography","label":"Geographic coordinates","content":"78 00 N, 20 00 E","ordinal":3,"locator":"factbook-2005/geos/sv.html#field:3","country":"SJ","edition_year":2005},{"category":"geography","label":"Map references","content":"Arctic Region","ordinal":4,"locator":"factbook-2005/geos/sv.html#field:4","country":"SJ","edition_year":2005},{"category":"geography","label":"Area","content":"total: 62,049 sq km\n\nland: 62,049 sq km\n\nwater: 0 sq km\n\nnote: includes Spitsbergen and Bjornoya (Bear Island)","ordinal":5,"locator":"factbook-2005/geos/sv.html#field:5","country":"SJ","edition_year":2005},{"category":"geography","label":"Area - comparative","content":"slightly smaller than West Virginia","ordinal":6,"locator":"factbook-2005/geos/sv.html#field:6","country":"SJ","edition_year":2005},{"category":"geography","label":"Land boundaries","content":"0 km","ordinal":7,"locator":"factbook-2005/geos/sv.html#field:7","country":"SJ","edition_year":2005},{"category":"geography","label":"Coastline","content":"3,587 km","ordinal":8,"locator":"factbook-2005/geos/sv.html#field:8","country":"SJ","edition_year":2005},{"category":"geography","label":"Maritime claims","content":"territorial sea: 4 nm\n\nexclusive fishing zone: 200 nm unilaterally claimed by Norway but not recognized by Russia","ordinal":9,"locator":"factbook-2005/geos/sv.html#field:9","country":"SJ","edition_year":2005},{"category":"geography","label":"Climate","content":"arctic, tempered by warm North Atlantic Current; cool summers, cold winters; North Atlantic Current flows along west and north coasts of Spitsbergen, keeping water open and navigable most of the year","ordinal":10,"locator":"factbook-2005/geos/sv.html#field:10","country":"SJ","edition_year":2005},{"category":"geography","label":"Terrain","content":"wild, rugged mountains; much of high land ice covered; west coast clear of ice about one-half of the year; fjords along west and north coasts","ordinal":11,"locator":"factbook-2005/geos/sv.html#field:11","country":"SJ","edition_year":2005},{"category":"geography","label":"Elevation extremes","content":"lowest point: Arctic Ocean 0 m\n\nhighest point: Newtontoppen 1,717 m","ordinal":12,"locator":"factbook-2005/geos/sv.html#field:12","country":"SJ","edition_year":2005},{"category":"geography","label":"Natural resources","content":"coal, iron ore, copper, zinc, phosphate, wildlife, fish","ordinal":13,"locator":"factbook-2005/geos/sv.html#field:13","country":"SJ","edition_year":2005},{"category":"geography","label":"Land use","content":"arable land: 0%\n\npermanent crops: 0%\n\nother: 100% (no trees, and the only bushes are crowberry and cloudberry) (2001)","ordinal":14,"locator":"factbook-2005/geos/sv.html#field:14","country":"SJ","edition_year":2005},{"category":"geography","label":"Irrigated land","content":"NA sq km","ordinal":15,"locator":"factbook-2005/geos/sv.html#field:15","country":"SJ","edition_year":2005},{"category":"geography","label":"Natural hazards","content":"ice floes often block the entrance to Bellsund (a transit point for coal export) on the west coast and occasionally make parts of the northeastern coast inaccessible to maritime traffic","ordinal":16,"locator":"factbook-2005/geos/sv.html#field:16","country":"SJ","edition_year":2005},{"category":"geography","label":"Environment - current issues","content":"NA","ordinal":17,"locator":"factbook-2005/geos/sv.html#field:17","country":"SJ","edition_year":2005},{"category":"geography","label":"Geography - note","content":"northernmost part of the Kingdom of Norway; consists of nine main islands; glaciers and snowfields cover 60% of the total area","ordinal":18,"locator":"factbook-2005/geos/sv.html#field:18","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Population","content":"2,701 (July 2005 est.)","ordinal":19,"locator":"factbook-2005/geos/sv.html#field:19","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Age structure","content":"0-14 years: NA\n\n15-64 years: NA\n\n65 years and over: NA","ordinal":20,"locator":"factbook-2005/geos/sv.html#field:20","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Population growth rate","content":"-0.02% (2005 est.)","ordinal":21,"locator":"factbook-2005/geos/sv.html#field:21","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Birth rate","content":"NA births/1,000 population","ordinal":22,"locator":"factbook-2005/geos/sv.html#field:22","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Death rate","content":"NA deaths/1,000 population","ordinal":23,"locator":"factbook-2005/geos/sv.html#field:23","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Net migration rate","content":"NA migrant(s)/1,000 population","ordinal":24,"locator":"factbook-2005/geos/sv.html#field:24","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Sex ratio","content":"NA%","ordinal":25,"locator":"factbook-2005/geos/sv.html#field:25","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Infant mortality rate","content":"total: NA\n\nmale: NA\n\nfemale: NA","ordinal":26,"locator":"factbook-2005/geos/sv.html#field:26","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Life expectancy at birth","content":"total population: NA years\n\nmale: NA years\n\nfemale: NA years","ordinal":27,"locator":"factbook-2005/geos/sv.html#field:27","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Total fertility rate","content":"NA children born/woman","ordinal":28,"locator":"factbook-2005/geos/sv.html#field:28","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"HIV/AIDS - adult prevalence rate","content":"0% (2001)","ordinal":29,"locator":"factbook-2005/geos/sv.html#field:29","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"HIV/AIDS - people living with HIV/AIDS","content":"0 (2001)","ordinal":30,"locator":"factbook-2005/geos/sv.html#field:30","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"HIV/AIDS - deaths","content":"0 (2001)","ordinal":31,"locator":"factbook-2005/geos/sv.html#field:31","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Ethnic groups","content":"Norwegian 55.4%, Russian and Ukrainian 44.3%, other 0.3% (1998)","ordinal":32,"locator":"factbook-2005/geos/sv.html#field:32","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Languages","content":"Norwegian, Russian","ordinal":33,"locator":"factbook-2005/geos/sv.html#field:33","country":"SJ","edition_year":2005},{"category":"people-and-society","label":"Literacy","content":"NA","ordinal":34,"locator":"factbook-2005/geos/sv.html#field:34","country":"SJ","edition_year":2005},{"category":"government","label":"Country name","content":"conventional long form: none\n\nconventional short form: Svalbard (sometimes referred to as Spitzbergen)","ordinal":35,"locator":"factbook-2005/geos/sv.html#field:35","country":"SJ","edition_year":2005},{"category":"government","label":"Dependency status","content":"territory of Norway; administered by the Polar Department of the Ministry of Justice, through a governor (sysselmann) residing in Longyearbyen, Spitsbergen; by treaty (9 February 1920) sovereignty was awarded to Norway","ordinal":36,"locator":"factbook-2005/geos/sv.html#field:36","country":"SJ","edition_year":2005},{"category":"government","label":"Government type","content":"NA","ordinal":37,"locator":"factbook-2005/geos/sv.html#field:37","country":"SJ","edition_year":2005},{"category":"government","label":"Capital","content":"Longyearbyen","ordinal":38,"locator":"factbook-2005/geos/sv.html#field:38","country":"SJ","edition_year":2005},{"category":"government","label":"Independence","content":"none (territory of Norway)","ordinal":39,"locator":"factbook-2005/geos/sv.html#field:39","country":"SJ","edition_year":2005},{"category":"government","label":"National holiday","content":"NA","ordinal":40,"locator":"factbook-2005/geos/sv.html#field:40","country":"SJ","edition_year":2005},{"category":"government","label":"Legal system","content":"NA","ordinal":41,"locator":"factbook-2005/geos/sv.html#field:41","country":"SJ","edition_year":2005},{"category":"government","label":"Executive branch","content":"chief of state: King HARALD V of Norway (since 17 January 1991)\n\nhead of government: Governor Odd Olsen INGERO (since 8 June 2001) and Assistant Governor Rune Baard HANSEN (since NA)\n\nelections: none; the monarch is hereditary; governor and assistant governor responsible to the Polar Department of the Ministry of Justice","ordinal":42,"locator":"factbook-2005/geos/sv.html#field:42","country":"SJ","edition_year":2005},{"category":"government","label":"International organization participation","content":"none","ordinal":43,"locator":"factbook-2005/geos/sv.html#field:43","country":"SJ","edition_year":2005},{"category":"government","label":"Flag description","content":"the flag of Norway is used","ordinal":44,"locator":"factbook-2005/geos/sv.html#field:44","country":"SJ","edition_year":2005},{"category":"economy","label":"Economy - overview","content":"Coal mining is the major economic activity on Svalbard. The treaty of 9 February 1920 gives the 41 signatories equal rights to exploit mineral deposits, subject to Norwegian regulation. Although US, UK, Dutch, and Swedish coal companies have mined in the past, the only companies still mining are Norwegian and Russian. The settlements on Svalbard are essentially company towns. The Norwegian state-owned coal company employs nearly 60% of the Norwegian population on the island, runs many of the local services, and provides most of the local infrastructure. There is also some hunting of seal, reindeer, and fox.","ordinal":45,"locator":"factbook-2005/geos/sv.html#field:45","country":"SJ","edition_year":2005},{"category":"economy","label":"GDP (purchasing power parity)","content":"$NA","ordinal":46,"locator":"factbook-2005/geos/sv.html#field:46","country":"SJ","edition_year":2005},{"category":"economy","label":"GDP - real growth rate","content":"NA%","ordinal":47,"locator":"factbook-2005/geos/sv.html#field:47","country":"SJ","edition_year":2005},{"category":"economy","label":"Labor force","content":"NA","ordinal":48,"locator":"factbook-2005/geos/sv.html#field:48","country":"SJ","edition_year":2005},{"category":"economy","label":"Budget","content":"revenues: $11.5 million\n\nexpenditures: $11.5 million, including capital expenditures of NA (1998 est.)","ordinal":49,"locator":"factbook-2005/geos/sv.html#field:49","country":"SJ","edition_year":2005},{"category":"economy","label":"Exports","content":"$NA","ordinal":50,"locator":"factbook-2005/geos/sv.html#field:50","country":"SJ","edition_year":2005},{"category":"economy","label":"Imports","content":"$NA","ordinal":51,"locator":"factbook-2005/geos/sv.html#field:51","country":"SJ","edition_year":2005},{"category":"economy","label":"Economic aid - recipient","content":"$8.2 million from Norway (1998)","ordinal":52,"locator":"factbook-2005/geos/sv.html#field:52","country":"SJ","edition_year":2005},{"category":"economy","label":"Currency (code)","content":"Norwegian krone (NOK)","ordinal":53,"locator":"factbook-2005/geos/sv.html#field:53","country":"SJ","edition_year":2005},{"category":"economy","label":"Exchange rates","content":"Norwegian kroner per US dollar - 6.7408 (2004), 7.0802 (2003), 7.9838 (2002), 8.9917 (2001), 8.8018 (2000)","ordinal":54,"locator":"factbook-2005/geos/sv.html#field:54","country":"SJ","edition_year":2005},{"category":"communications","label":"Telephones - main lines in use","content":"NA","ordinal":55,"locator":"factbook-2005/geos/sv.html#field:55","country":"SJ","edition_year":2005},{"category":"communications","label":"Telephones - mobile cellular","content":"NA","ordinal":56,"locator":"factbook-2005/geos/sv.html#field:56","country":"SJ","edition_year":2005},{"category":"communications","label":"Telephone system","content":"general assessment: probably adequate\n\ndomestic: local telephone service\n\ninternational: country code - 47-790; satellite earth station - 1 of unknown type (for communication with Norwegian mainland only)","ordinal":57,"locator":"factbook-2005/geos/sv.html#field:57","country":"SJ","edition_year":2005},{"category":"communications","label":"Radio broadcast stations","content":"AM 1, FM 1 (plus 2 repeaters), shortwave 0 (1998)","ordinal":58,"locator":"factbook-2005/geos/sv.html#field:58","country":"SJ","edition_year":2005},{"category":"communications","label":"Television broadcast stations","content":"NA","ordinal":59,"locator":"factbook-2005/geos/sv.html#field:59","country":"SJ","edition_year":2005},{"catego