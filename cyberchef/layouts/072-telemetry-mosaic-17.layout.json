{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "telemetry-mosaic-17",
  "label": "Telemetry Mosaic 17",
  "description": "Telemetry Mosaic 17: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "ops recipe io",
      "ops recipe io",
      "recipe recipe io"
    ],
    "columns": [
      "minmax(0,74fr)",
      "minmax(0,36fr)",
      "minmax(0,59fr)"
    ],
    "rows": [
      "minmax(0,25fr)",
      "minmax(0,56fr)",
      "minmax(0,87fr)"
    ],
    "gap": 5,
    "minHeight": 750,
    "padding": 0.25
  },
  "io": {
    "orientation": "vertical",
    "split": [
      60,
      40
    ],
    "gap": 3
  },
  "density": {
    "scale": 0.84,
    "operationPadding": 2,
    "bannerHeight": 48
  },
  "mobile": {
    "areas": [
      "ops",
      "io",
      "recipe"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      47,
      53
    ],
    "zoom": 0.7
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": false
  }
}
