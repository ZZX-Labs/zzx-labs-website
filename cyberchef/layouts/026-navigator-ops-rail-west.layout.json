{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "navigator-ops-rail-west",
  "label": "Navigator Ops Rail West",
  "description": "Navigator Ops Rail West: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "ops recipe",
      "ops io"
    ],
    "columns": [
      "minmax(0,25fr)",
      "minmax(0,48fr)"
    ],
    "rows": [
      "minmax(0,61fr)",
      "minmax(0,92fr)"
    ],
    "gap": 10,
    "minHeight": 848,
    "padding": 0.57
  },
  "io": {
    "orientation": "vertical",
    "split": [
      48,
      52
    ],
    "gap": 8
  },
  "density": {
    "scale": 0.86,
    "operationPadding": 5,
    "bannerHeight": 42
  },
  "mobile": {
    "areas": [
      "io",
      "recipe",
      "ops"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "vertical",
    "ioSplit": [
      50,
      50
    ],
    "zoom": 0.61
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": true,
    "compactBanner": true
  }
}
