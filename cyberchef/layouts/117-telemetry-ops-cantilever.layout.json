{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "telemetry-ops-cantilever",
  "label": "Telemetry Ops Cantilever",
  "description": "Telemetry Ops Cantilever: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "recipe ops ops",
      "recipe io io"
    ],
    "columns": [
      "minmax(0,28fr)",
      "minmax(0,51fr)",
      "minmax(0,74fr)"
    ],
    "rows": [
      "minmax(0,57fr)",
      "minmax(0,88fr)"
    ],
    "gap": 10,
    "minHeight": 812,
    "padding": 0.49
  },
  "io": {
    "orientation": "vertical",
    "split": [
      57,
      43
    ],
    "gap": 8
  },
  "density": {
    "scale": 1.05,
    "operationPadding": 5,
    "bannerHeight": 58
  },
  "mobile": {
    "areas": [
      "recipe",
      "io",
      "ops"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      50,
      50
    ],
    "zoom": 0.65
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": false
  }
}
