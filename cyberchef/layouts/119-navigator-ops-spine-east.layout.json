{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "navigator-ops-spine-east",
  "label": "Navigator Ops Spine East",
  "description": "Navigator Ops Spine East: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "recipe recipe ops",
      "io io ops"
    ],
    "columns": [
      "minmax(0,54fr)",
      "minmax(0,77fr)",
      "minmax(0,39fr)"
    ],
    "rows": [
      "minmax(0,25fr)",
      "minmax(0,56fr)"
    ],
    "gap": 5,
    "minHeight": 586,
    "padding": 0.25
  },
  "io": {
    "orientation": "vertical",
    "split": [
      40,
      60
    ],
    "gap": 3
  },
  "density": {
    "scale": 0.92,
    "operationPadding": 7,
    "bannerHeight": 40
  },
  "mobile": {
    "areas": [
      "ops",
      "io",
      "recipe"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      52,
      48
    ],
    "zoom": 0.75
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": true
  }
}
