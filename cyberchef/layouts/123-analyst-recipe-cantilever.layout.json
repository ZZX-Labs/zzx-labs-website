{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "analyst-recipe-cantilever",
  "label": "Analyst Recipe Cantilever",
  "description": "Analyst Recipe Cantilever: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "ops recipe recipe",
      "ops io io"
    ],
    "columns": [
      "minmax(0,45fr)",
      "minmax(0,68fr)",
      "minmax(0,30fr)"
    ],
    "rows": [
      "minmax(0,31fr)",
      "minmax(0,62fr)"
    ],
    "gap": 6,
    "minHeight": 734,
    "padding": 0.57
  },
  "io": {
    "orientation": "vertical",
    "split": [
      37,
      63
    ],
    "gap": 4
  },
  "density": {
    "scale": 0.93,
    "operationPadding": 4,
    "bannerHeight": 60
  },
  "mobile": {
    "areas": [
      "recipe",
      "io",
      "ops"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      49,
      51
    ],
    "zoom": 0.61
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": true
  }
}
