{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "studio-ops-bridge",
  "label": "Studio Ops Bridge",
  "description": "Studio Ops Bridge: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "ops ops recipe",
      "io io recipe"
    ],
    "columns": [
      "minmax(0,76fr)",
      "minmax(0,38fr)",
      "minmax(0,61fr)"
    ],
    "rows": [
      "minmax(0,38fr)",
      "minmax(0,69fr)"
    ],
    "gap": 7,
    "minHeight": 775,
    "padding": 0.41
  },
  "io": {
    "orientation": "horizontal",
    "split": [
      50,
      50
    ],
    "gap": 5
  },
  "density": {
    "scale": 0.98,
    "operationPadding": 4,
    "bannerHeight": 53
  },
  "mobile": {
    "areas": [
      "io",
      "ops",
      "recipe"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      49,
      51
    ],
    "zoom": 0.6
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": false
  }
}
