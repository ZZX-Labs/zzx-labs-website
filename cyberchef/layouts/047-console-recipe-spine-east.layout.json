  "workspace": {
    "areas": [
      "ops ops recipe",
      "io io recipe"
    ],
    "columns": [
      "minmax(0,54fr)",
      "minmax(0,77fr)",
      "minmax(0,39fr)"
    ],
    "rows": [
      "minmax(0,40fr)",
      "minmax(0,71fr)"
    ],
    "gap": 7,
    "minHeight": 725,
    "padding": 0.25
  },
  "io": {
    "orientation": "horizontal",
    "split": [
      40,
      60
    ],
    "gap": 5
  },
  "density": {
    "scale": 0.98,
    "operationPadding": 5,
    "bannerHeight": 35
  },
  "mobile": {
    "areas": [
      "recipe",
      "ops",
      "io"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
