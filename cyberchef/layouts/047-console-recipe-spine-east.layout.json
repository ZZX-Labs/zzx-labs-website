    "ioOrientation": "vertical",
    "ioSplit": [
      50,
      50
    ],
    "zoom": 0.64
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": true,
    "compactBanner": false
  }
