{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "command-io-bridge",
  "label": "Command Io Bridge",
  "description": "Command Io Bridge: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "io io ops",
      "recipe recipe ops"
    ],
    "columns": [
      "minmax(0,32fr)",
      "minmax(0,55fr)",
      "minmax(0,78fr)"
    ],
    "rows": [
      "minmax(0,27fr)",
      "minmax(0,58fr)"
    ],
    "gap": 5,
    "minHeight": 836,
    "padding": 0.49
  },
  "io": {
    "orientation": "vertical",
    "split": [
      61,
      39
    ],
    "gap": 3
  },
  "density": {
    "scale": 0.92,
    "operationPadding": 8,
    "bannerHeight": 50
  },
  "mobile": {
    "areas": [
      "io",
      "recipe",
      "ops"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "vertical",
    "ioSplit": [
      53,
      47
    ],
    "zoom": 0.62
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": true,
    "compactBanner": true
  }
}
