      "minmax(0,21fr)",
      "minmax(0,44fr)"
    ],
    "rows": [
      "minmax(0,79fr)",
      "minmax(0,40fr)"
    ],
    "gap": 13,
    "minHeight": 692,
    "padding": 0.33
  },
  "io": {
    "orientation": "vertical",
    "split": [
      39,
      61
    ],
    "gap": 11
  },
  "density": {
    "scale": 0.89,
    "operationPadding": 3,
    "bannerHeight": 46
  },
  "mobile": {
    "areas": [
      "io",
      "recipe",
      "ops"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "vertical",
    "ioSplit": [
      48,
      52
    ],
    "zoom": 0.7
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": true,
    "compactBanner": true
  }
