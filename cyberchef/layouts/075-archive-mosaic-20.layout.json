{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "archive-mosaic-20",
  "label": "Archive Mosaic 20",
  "description": "Archive Mosaic 20: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "recipe recipe recipe",
      "ops ops io",
      "ops ops io"
    ],
    "columns": [
      "minmax(0,52fr)",
      "minmax(0,75fr)",
      "minmax(0,37fr)"
    ],
    "rows": [
      "minmax(0,82fr)",
      "minmax(0,43fr)",
      "minmax(0,74fr)"
    ],
    "gap": 14,
    "minHeight": 561,
    "padding": 0.49
  },
  "io": {
    "orientation": "horizontal",
    "split": [
      50,
      50
    ],
    "gap": 12
  },
  "density": {
    "scale": 1.05,
    "operationPadding": 5,
    "bannerHeight": 35
  },
  "mobile": {
    "areas": [
      "io",
      "ops",
      "recipe"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      50,
      50
    ],
    "zoom": 0.68
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": false
  }
}
