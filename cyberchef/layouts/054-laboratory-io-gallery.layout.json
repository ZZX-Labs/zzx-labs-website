{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "laboratory-io-gallery",
  "label": "Laboratory Io Gallery",
  "description": "Laboratory Io Gallery: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "io io recipe",
      "ops ops recipe"
    ],
    "columns": [
      "minmax(0,23fr)",
      "minmax(0,46fr)",
      "minmax(0,69fr)"
    ],
    "rows": [
      "minmax(0,33fr)",
      "minmax(0,64fr)"
    ],
    "gap": 6,
    "minHeight": 684,
    "padding": 0.41
  },
  "io": {
    "orientation": "vertical",
    "split": [
      58,
      42
    ],
    "gap": 4
  },
  "density": {
    "scale": 0.93,
    "operationPadding": 5,
    "bannerHeight": 42
  },
  "mobile": {
    "areas": [
      "ops",
      "io",
      "recipe"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      50,
      50
    ],
    "zoom": 0.65
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": true
  }
}
