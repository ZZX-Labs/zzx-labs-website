{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "grid-recipe-gallery",
  "label": "Grid Recipe Gallery",
  "description": "Grid Recipe Gallery: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "recipe recipe io",
      "ops ops io"
    ],
    "columns": [
      "minmax(0,67fr)",
      "minmax(0,29fr)",
      "minmax(0,52fr)"
    ],
    "rows": [
      "minmax(0,59fr)",
      "minmax(0,90fr)"
    ],
    "gap": 10,
    "minHeight": 762,
    "padding": 0.33
  },
  "io": {
    "orientation": "vertical",
    "split": [
      47,
      53
    ],
    "gap": 8
  },
  "density": {
    "scale": 1.05,
    "operationPadding": 6,
    "bannerHeight": 40
  },
  "mobile": {
    "areas": [
      "ops",
      "io",
      "recipe"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      51,
      49
    ],
    "zoom": 0.69
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": false
  }
}
