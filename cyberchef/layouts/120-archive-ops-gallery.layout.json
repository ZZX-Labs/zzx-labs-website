{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "archive-ops-gallery",
  "label": "Archive Ops Gallery",
  "description": "Archive Ops Gallery: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "ops ops io",
      "recipe recipe io"
    ],
    "columns": [
      "minmax(0,67fr)",
      "minmax(0,29fr)",
      "minmax(0,52fr)"
    ],
    "rows": [
      "minmax(0,44fr)",
      "minmax(0,75fr)"
    ],
    "gap": 8,
    "minHeight": 623,
    "padding": 0.33
  },
  "io": {
    "orientation": "horizontal",
    "split": [
      47,
      53
    ],
    "gap": 6
  },
  "density": {
    "scale": 0.99,
    "operationPadding": 8,
    "bannerHeight": 45
  },
  "mobile": {
    "areas": [
      "ops",
      "recipe",
      "io"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      53,
      47
    ],
    "zoom": 0.63
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": false
  }
}
