{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "deck-recipe-gallery",
  "label": "Deck Recipe Gallery",
  "description": "Deck Recipe Gallery: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "recipe recipe io",
      "ops ops io"
    ],
    "columns": [
      "minmax(0,23fr)",
      "minmax(0,46fr)",
      "minmax(0,69fr)"
    ],
    "rows": [
      "minmax(0,88fr)",
      "minmax(0,49fr)"
    ],
    "gap": 4,
    "minHeight": 845,
    "padding": 0.41
  },
  "io": {
    "orientation": "horizontal",
    "split": [
      58,
      42
    ],
    "gap": 3
  },
  "density": {
    "scale": 0.87,
    "operationPadding": 7,
    "bannerHeight": 47
  },
  "mobile": {
    "areas": [
      "ops",
      "recipe",
      "io"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      52,
      48
    ],
    "zoom": 0.76
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": false
  }
}
