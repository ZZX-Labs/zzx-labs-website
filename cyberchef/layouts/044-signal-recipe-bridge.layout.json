    "ioOrientation": "vertical",
    "ioSplit": [
      47,
      53
    ],
    "zoom": 0.66
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": true,
    "compactBanner": false
