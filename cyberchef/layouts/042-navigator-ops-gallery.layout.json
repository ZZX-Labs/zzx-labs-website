{
  "schema": "zzx-cyberchef-layout-v2",
  "id": "navigator-ops-gallery",
  "label": "Navigator Ops Gallery",
  "description": "Navigator Ops Gallery: unique CyberChef workspace topology; pane order, grid spans, I/O orientation, density and mobile order are encoded independently.",
  "workspace": {
    "areas": [
      "ops ops io",
      "recipe recipe io"
    ],
    "columns": [
      "minmax(0,50fr)",
      "minmax(0,73fr)",
      "minmax(0,35fr)"
    ],
    "rows": [
      "minmax(0,85fr)",
      "minmax(0,46fr)"
    ],
    "gap": 14,
    "minHeight": 840,
    "padding": 0.25
  },
  "io": {
    "orientation": "vertical",
    "split": [
      36,
      64
    ],
    "gap": 12
  },
  "density": {
    "scale": 0.9,
    "operationPadding": 7,
    "bannerHeight": 38
  },
  "mobile": {
    "areas": [
      "ops",
      "io",
      "recipe"
    ],
    "columns": [
      "minmax(0,1fr)"
    ],
    "rows": [
      "auto",
      "auto",
      "minmax(500px,1fr)"
    ],
    "ioOrientation": "horizontal",
    "ioSplit": [
      52,
      48
    ],
    "zoom": 0.73
  },
  "behavior": {
    "hideGutters": true,
    "scrollOperations": true,
    "stickyTitles": false,
    "compactBanner": true
  }
}
