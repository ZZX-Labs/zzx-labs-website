{
  "schema": "zzx-worldfactbook-archive-source-catalog-v1",
  "scan": {
    "start_year": 1962,
    "end_year": 2025,
    "policy": "Discover public editions dynamically. Missing years remain missing; never synthesize an edition."
  },
  "internet_archive": {
    "advanced_search": "https://archive.org/advancedsearch.php",
    "metadata": "https://archive.org/metadata/{identifier}",
    "download": "https://archive.org/download/{identifier}/{filename}",
    "item": "https://archive.org/details/{identifier}",
    "queries": [
      "(title:\"World Factbook\" OR title:\"The World Factbook\" OR title:\"CIA World Factbook\") AND year:{year}",
      "(subject:\"World Factbook\" OR description:\"World Factbook\") AND year:{year}"
    ],
    "preferred_files": [
      "*_djvu.txt",
      "*.txt",
      "*.zip",
      "*.tar.gz",
      "*.tgz",
      "*.html",
      "*.htm"
    ]
  },
  "wayback": {
    "cdx": "https://web.archive.org/cdx/search/cdx",
    "replay": "https://web.archive.org/web/{timestamp}id_/{original}",
    "url_families": [
      "https://www.cia.gov/the-world-factbook/",
      "https://www.cia.gov/library/publications/the-world-factbook/",
      "https://www.cia.gov/cia/publications/factbook/",
      "http://www.odci.gov/cia/publications/factbook/"
    ]
  },
  "outputs": {
    "electricity_history": "/worldfactbook/api/electricity-history.json",
    "reference_index": "/worldfactbook/api/reference-index.json",
    "power_grid_projection": "/bitcoin/power-grid/api/factbook-history.json"
  }
}